# ===== Project data =====
# Track catalogs in Git, ale ignoruj runtime state/outbox (commitovat nechceš)
workshops_ai/data/state/**
!workshops_ai/data/state/.gitkeep
workshops_ai/data/outbox/**
!workshops_ai/data/outbox/.gitkeep

# Katalogy ponech ve verzi (neignorovat)
!workshops_ai/data/catalogs/**
# Pokud bys exportoval i binární katalogy/artefakty, můžeš případně ignorovat:
# workshops_ai/data/catalogs/*.parquet

# ===== Embedding/model caches (lokální) =====
.cache/
.huggingface/

# (Volitelné) Qdrant lokální data, pokud je mapuješ do repo složky:
# qdrant_data/
