# =============================================================================
# BASIC APPLICATION SETTINGS
# =============================================================================

# Environment (dev, staging, production)
WORKSHOPS_AI_ENV=production

# Service metadata
WORKSHOPS_AI_SERVICE_NAME=AI Risk Analysis API
WORKSHOPS_AI_VERSION=1.1.0

# Logging
WORKSHOPS_AI_LOG_LEVEL=INFO

# Server configuration
WORKSHOPS_AI_APP_HOST=0.0.0.0
WORKSHOPS_AI_APP_PORT=8000

# API Documentation (set to true for development)
WORKSHOPS_AI_ENABLE_DOCS=false

# Auto-reload (development only)
WORKSHOPS_AI_RELOAD=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins (JSON array or comma-separated)
# Examples:
# WORKSHOPS_AI_CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]
# WORKSHOPS_AI_CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# WORKSHOPS_AI_CORS_ORIGINS=["*"]  # Allow all origins (development only)
WORKSHOPS_AI_CORS_ORIGINS=["https://yourdomain.com"]

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# Disable all authentication (development only — NEVER set true in production!)
WORKSHOPS_AI_SECURITY__DISABLE_ALL_AUTH=false

# API Key Authentication
WORKSHOPS_AI_SECURITY__ENABLE_API_KEY=true
WORKSHOPS_AI_SECURITY__API_KEYS=["your-secure-api-key-here", "backup-api-key"]

# JWT Authentication (optional - for advanced setups)
WORKSHOPS_AI_SECURITY__ENABLE_JWT=false
WORKSHOPS_AI_SECURITY__JWT_ALGORITHM=HS256
WORKSHOPS_AI_SECURITY__JWT_SECRET=your-jwt-secret-key-here
WORKSHOPS_AI_SECURITY__JWT_ISSUER=https://auth.yourdomain.com
WORKSHOPS_AI_SECURITY__JWT_AUDIENCE=workshops-ai
WORKSHOPS_AI_SECURITY__JWKS_URL=https://auth.yourdomain.com/.well-known/jwks.json

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL
WORKSHOPS_AI_REDIS__URL=redis://localhost:6379/0

# LangGraph Checkpointer (for conversation state)
WORKSHOPS_AI_CHECKPOINTER=redis
WORKSHOPS_AI_REDIS_URL=redis://localhost:6379/0
WORKSHOPS_AI_CHECKPOINT_NS=lg:ckpt
WORKSHOPS_AI_CHECKPOINT_TTL_SEC=1209600

# SQLite fallback (if not using Redis)
WORKSHOPS_AI_SQLITE_CKPT_PATH=/app/workshops_ai/data/state/checkpoints.db

# =============================================================================
# OPENAI / LLM CONFIGURATION
# =============================================================================

# LLM Settings (Workshops / Chat — NOT used by Wizard, which has its own config below)
# Provider: "openai" (direct OpenAI) or "azure" (Azure OpenAI)
WORKSHOPS_AI_LLM__PROVIDER=azure
WORKSHOPS_AI_LLM__API_KEY=your-azure-openai-api-key
WORKSHOPS_AI_LLM__AZURE_ENDPOINT=https://your-resource.openai.azure.com/
WORKSHOPS_AI_LLM__AZURE_API_VERSION=2025-03-01-preview
WORKSHOPS_AI_LLM__MODEL=gpt-5.1-chat                       # Default model for Workshops/Chat agent (Wizard uses WIZARD__DEFAULT_MODEL)
WORKSHOPS_AI_LLM__TEMPERATURE=0.0                          # Temperature for Workshops/Chat (Wizard uses WIZARD__TEMPERATURE)
WORKSHOPS_AI_LLM__CALL_TIMEOUT_SEC=240                     # Per-call LLM/agent timeout (legacy alias: WORKSHOPS_AI_LLM__HTTP_TIMEOUT_SEC)
WORKSHOPS_AI_LLM__OPENAI_MAX_RETRIES=3

# OpenAI direct (uncomment when PROVIDER=openai)
#WORKSHOPS_AI_LLM__PROVIDER=openai
#OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# OPENAI RATE LIMITING & THROTTLING
# =============================================================================

# OpenAI API throttling to prevent rate limit errors
# RPM = Requests Per Minute, TPM = Tokens Per Minute
# Adjust these based on your OpenAI/Azure tier limits
WORKSHOPS_AI_OPENAI_THROTTLE__ENABLED=true

# --- Azure OpenAI (current) ---
# Azure quotas are per-deployment; typical 100K TPM tier:
WORKSHOPS_AI_OPENAI_THROTTLE__RPM=100
WORKSHOPS_AI_OPENAI_THROTTLE__TPM=100000
WORKSHOPS_AI_OPENAI_THROTTLE__MAX_CONCURRENT=50

# --- OpenAI direct (uncomment when switching to PROVIDER=openai) ---
#WORKSHOPS_AI_OPENAI_THROTTLE__RPM=450
#WORKSHOPS_AI_OPENAI_THROTTLE__TPM=2000000
#WORKSHOPS_AI_OPENAI_THROTTLE__MAX_CONCURRENT=50

# =============================================================================
# RATE LIMITING (FastAPI endpoints)
# =============================================================================

WORKSHOPS_AI_RATELIMIT__ENABLED=true
WORKSHOPS_AI_RATELIMIT__PER_MINUTE=120

# =============================================================================
# TELEMETRY & LOGGING
# =============================================================================

WORKSHOPS_AI_TELEMETRY__ENABLED=true
WORKSHOPS_AI_TELEMETRY__LEVEL=INFO
WORKSHOPS_AI_TELEMETRY__LOG_TO_FILE=false
WORKSHOPS_AI_TELEMETRY__LOG_FILE_PATH=/app/logs/workshops_ai.log
WORKSHOPS_AI_TELEMETRY__MAX_PAYLOAD_LEN=16000

# =============================================================================
# MEMORY MANAGEMENT
# =============================================================================

WORKSHOPS_AI_MEMORY__MAX_ORG_KEYS=2000
WORKSHOPS_AI_MEMORY__MAX_VALUE_BYTES=65536
WORKSHOPS_AI_MEMORY__SOFT_TOTAL_BYTES_PER_ORG=8388608

# =============================================================================
# CHAT & WEBSOCKET SETTINGS
# =============================================================================

# HTTP Chat endpoint
WORKSHOPS_AI_CHAT__TIMEOUT_SEC=180
WORKSHOPS_AI_CHAT__MAX_MESSAGE_LEN=4000

# WebSocket settings
WORKSHOPS_AI_WS__TIMEOUT_SEC=75
WORKSHOPS_AI_WS__COOKIE_NAME=wsai.sid

# =============================================================================
# MANAGER & AGENT TIMEOUTS
# =============================================================================

WORKSHOPS_AI_MANAGER__AGENT_TIMEOUT_SEC=45
WORKSHOPS_AI_MANAGER__THREATS_TIMEOUT_SEC=90
WORKSHOPS_AI_MANAGER__MAX_HISTORY_TOKENS=4000

# Per-tab agent timeouts (optional overrides)
#AGENT_TIMEOUT_SEC_ASSETS=30
#AGENT_TIMEOUT_SEC_IMPACTS=30
#AGENT_TIMEOUT_SEC_THREATS=60

# =============================================================================
# WIZARD CONFIGURATION
# =============================================================================

# Session management
WORKSHOPS_AI_WIZARD__SESSION_TTL_HOURS=8
WORKSHOPS_AI_WIZARD__SESSION_CREATION_RATE_LIMIT=10

# LLM settings for wizard (independent from global LLM settings above)
# Default model used when request body has no ai_model field
WORKSHOPS_AI_WIZARD__DEFAULT_MODEL=gpt-5-mini
# Temperature for non-reasoning models (reasoning models like gpt-5* ignore temperature)
WORKSHOPS_AI_WIZARD__TEMPERATURE=0.2
# Reasoning effort for reasoning models (gpt-5*, gpt-6*, o1, o3, o4): low, medium, high, minimal
# Cascade: per-request body field `reasoning_effort` > REASONING_EFFORT_BY_MODEL > this env var > Pydantic default
# Ignored for non-reasoning models (gpt-4o, gpt-4o-mini, etc.)
WORKSHOPS_AI_WIZARD__REASONING_EFFORT=medium
# Reasoning effort per model, e.g. {"gpt-6-luna": "high"}; models not listed use REASONING_EFFORT
WORKSHOPS_AI_WIZARD__REASONING_EFFORT_BY_MODEL={}
WORKSHOPS_AI_WIZARD__LLM_TIMEOUT_SEC=240
WORKSHOPS_AI_WIZARD__LLM_MAX_RETRIES=3
WORKSHOPS_AI_WIZARD__ALLOWED_MODELS=["gpt-5", "gpt-5-mini", "gpt-5-nano", "gpt-5.1-chat", "gpt-5.4-mini", "gpt-5.4-nano", "gpt-4.1", "gpt-4o", "gpt-4o-mini"]
WORKSHOPS_AI_WIZARD__EXPOSE_DEBUG_INFO=true
WORKSHOPS_AI_WIZARD__MAX_CONTENT_LENGTH=20000

# Batch Processing
# Max assets per LLM call (automatic internal chunking for impacts/risks/controls)
# Lower = safer but slower, higher = faster but may hit LLM limits
WORKSHOPS_AI_WIZARD__MAX_BATCH_SIZE=50

# OpenAI pricing per 1K tokens (JSON format — used for cost estimation in debug output)
WORKSHOPS_AI_WIZARD__OPENAI_PRICING={"gpt-5":{"prompt":0.00125,"completion":0.01},"gpt-5-mini":{"prompt":0.00025,"completion":0.002},"gpt-4.1":{"prompt":0.002,"completion":0.008},"gpt-4o":{"prompt":0.0025,"completion":0.010},"gpt-4o-mini":{"prompt":0.00015,"completion":0.0006}}

# Per-request token limits (JSON format — max tokens allowed per single LLM call)
# Exceeding this triggers RequestTooLargeError with a suggested smaller batch size.
WORKSHOPS_AI_WIZARD__OPENAI_PER_REQUEST_LIMITS={"gpt-5-mini":300000,"gpt-5-nano":500000,"gpt-5.1-chat":300000,"gpt-5.4-mini":300000,"gpt-5.4-nano":500000,"gpt-4.1":300000,"gpt-4o":30000,"gpt-4o-mini":200000}

# Per-model capacity TPM (tokens-per-minute) — Azure deployment quota.
# Enforced via per-model sliding window: when the 60s rolling sum would exceed
# this limit, the call waits (does not reject). Overrides global throttle TPM for matching models.
WORKSHOPS_AI_WIZARD__OPENAI_CAPACITY_LIMITS={"gpt-5-mini":1000000,"gpt-5-nano":5000000,"gpt-5.1-chat":1000000,"gpt-5.4-mini":1000000,"gpt-5.4-nano":5000000,"gpt-4.1":1000000,"gpt-4o":450000,"gpt-4o-mini":2000000}

# Content Retrieval Method
# Default method for fetching website content when not specified in request
# Options: "scrape" (traditional HTML parsing) or "web_search" (LLM-based web search)
WORKSHOPS_AI_WIZARD__DEFAULT_SEARCH_METHOD=scrape

# Web Search (LLM-based web search using OpenAI)
# Uses OpenAI's web search tool for content retrieval
WORKSHOPS_AI_WIZARD__WEB_SEARCH_ENABLED=true
WORKSHOPS_AI_WIZARD__WEB_SEARCH_MODEL=gpt-5-nano
# Reasoning effort for reasoning models (gpt-5, o1, etc): low, medium, high
# Leave empty or omit for non-reasoning models (gpt-4o, gpt-4o-mini)
WORKSHOPS_AI_WIZARD__WEB_SEARCH_REASONING_EFFORT=low
WORKSHOPS_AI_WIZARD__WEB_SEARCH_TIMEOUT_SEC=180
WORKSHOPS_AI_WIZARD__WEB_SEARCH_MIN_CONTENT_CHARS=50

# Traditional Web Scraping (BeautifulSoup-based HTML parsing)
WORKSHOPS_AI_WIZARD__SCRAPE_ENABLED=true
WORKSHOPS_AI_WIZARD__SCRAPE_TIMEOUT_SEC=10
WORKSHOPS_AI_WIZARD__SCRAPE_MAX_RETRIES=2
WORKSHOPS_AI_WIZARD__SCRAPE_CONCURRENT_LIMIT=8
WORKSHOPS_AI_WIZARD__SCRAPE_MAX_PAGE_CHARS=6144
WORKSHOPS_AI_WIZARD__SCRAPE_MAX_COMBINED_CHARS=200000
WORKSHOPS_AI_WIZARD__SCRAPE_MIN_PAGE_CHARS=100
WORKSHOPS_AI_WIZARD__SCRAPE_STRICT_SANITIZATION=true
WORKSHOPS_AI_WIZARD__SCRAPE_MAX_SECURITY_WARNINGS=5

# =============================================================================
# RAG (RETRIEVAL-AUGMENTED GENERATION)
# =============================================================================

WORKSHOPS_AI_RAG__ENABLED=true
WORKSHOPS_AI_RAG__STORE=chroma
WORKSHOPS_AI_RAG__DATA_DIR=/app/workshops_ai/data/chroma
WORKSHOPS_AI_RAG__NAMESPACE=rag
WORKSHOPS_AI_RAG__EMBED_PROVIDER=fastembed
WORKSHOPS_AI_RAG__EMBED_MODEL=BAAI/bge-small-en-v1.5
WORKSHOPS_AI_RAG__TOP_K=6
WORKSHOPS_AI_RAG__MMR_ENABLED=true
WORKSHOPS_AI_RAG__MMR_LAMBDA=0.5
WORKSHOPS_AI_RAG__MMR_POOL=12
WORKSHOPS_AI_RAG__CHUNK_SIZE=1200
WORKSHOPS_AI_RAG__CHUNK_OVERLAP=200
WORKSHOPS_AI_RAG__MAX_PAGES=0
WORKSHOPS_AI_RAG__UUID5_NAMESPACE=00000000-0000-5000-a000-000000000000

# =============================================================================
# LANGCHAIN / LANGSMITH (OPTIONAL)
# =============================================================================

# LangSmith tracing (for debugging and monitoring)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=workshops-ai

# =============================================================================
# LANGFUSE (OPTIONAL)
# =============================================================================

# Langfuse tracing and prompt management
#LANGFUSE_ENABLED=true
#LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
#LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
#LANGFUSE_BASE_URL=https://cloud.langfuse.com
#LANGFUSE_PROMPT_LABEL=production
#LANGFUSE_ENVIRONMENT=production

# =============================================================================
# CATALOG PROVIDER
# =============================================================================

# Catalog mode: file (CSV mockup) or http (Tazilla API)
WORKSHOPS_AI_CATALOG__MODE=file
WORKSHOPS_AI_CATALOG__ENDPOINT=https://api.tazilla.com/catalogs
WORKSHOPS_AI_CATALOG__AUTH_TOKEN=change-me-bearer-token
WORKSHOPS_AI_CATALOG__TIMEOUT_SEC=30

# =============================================================================
# LEGACY SUPPORT (for backward compatibility)
# =============================================================================

# These are legacy environment variables that are still supported
# but the nested versions above are preferred

# Legacy LLM settings
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0

# Legacy paths
# DATA_DIR=./workshops_ai/data
# STATE_DIR=./workshops_ai/data/state
# CAT_DIR=./workshops_ai/data/catalogs

# Legacy timeouts
# WS_TIMEOUT_SEC=75
# MAX_MESSAGE_LEN=4000
